# ============================================================
# CONFIGURATION MODULE NUTRITION IA - VARIABLES D'ENVIRONNEMENT
# ============================================================

# Fournisseur IA : 'openai' | 'gemini' | 'groq' | 'ollama'
AI_PROVIDER=openai

# Clé API secrète (NE JAMAIS PARTAGER NI COMMITTER)
# Exemples :
# OpenAI : sk-proj-...
# Gemini : AIzaSy...
AI_API_KEY=

# URL de l'API IA (optionnel - défauts configurés automatiquement)
# OpenAI standard : https://api.openai.com/v1
# Groq Cloud : https://api.groq.com/openai/v1
# Ollama local : http://localhost:11434/v1
# Google Gemini : https://generativelanguage.googleapis.com/v1beta/models
AI_API_URL=https://api.openai.com/v1

# Modèle utilisé
# Pour OpenAI : gpt-4o-mini ou gpt-4o
# Pour Gemini : gemini-1.5-flash ou gemini-1.5-pro
# Pour Groq : llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini

# Port du serveur Express (défaut 4000)
PORT=4000
